<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- rotaidem.com's palette (cloudflare/public/site.css :root). -->
    <Color x:Key="NavyColor">#0B0C0E</Color>
    <Color x:Key="BgColor">#111315</Color>
    <Color x:Key="AccentColor">#AAB6C2</Color>
    <SolidColorBrush x:Key="Navy" Color="#0B0C0E" />
    <SolidColorBrush x:Key="NavyHover" Color="#1F2327" />
    <SolidColorBrush x:Key="Navy2" Color="#16191C" />
    <SolidColorBrush x:Key="Bg" Color="#111315" />
    <SolidColorBrush x:Key="Bg2" Color="#17191C" />
    <SolidColorBrush x:Key="Surface" Color="#16191C" />
    <SolidColorBrush x:Key="Ink" Color="#EEF0F2" />
    <SolidColorBrush x:Key="Text" Color="#C0C4C9" />
    <SolidColorBrush x:Key="Muted" Color="#878D94" />
    <SolidColorBrush x:Key="Line" Color="#262A2E" />
    <SolidColorBrush x:Key="FieldLine" Color="#30353A" />
    <SolidColorBrush x:Key="GhostLine" Color="#3A3F45" />
    <SolidColorBrush x:Key="Accent" Color="#AAB6C2" />
    <SolidColorBrush x:Key="AccentInk" Color="#DFE5EA" />
    <SolidColorBrush x:Key="AccentHover" Color="#CFD7DE" />
    <SolidColorBrush x:Key="AccentGlow" Color="#40AAB6C2" />
    <SolidColorBrush x:Key="Ok" Color="#4CC38A" />
    <SolidColorBrush x:Key="OkSoft" Color="#1F4CC38A" />
    <SolidColorBrush x:Key="Info" Color="#8AB8EE" />
    <SolidColorBrush x:Key="InfoSoft" Color="#1F8AB8EE" />
    <SolidColorBrush x:Key="Warn" Color="#E2B04A" />
    <SolidColorBrush x:Key="WarnSoft" Color="#1FE2B04A" />
    <SolidColorBrush x:Key="Danger" Color="#E5484D" />
    <SolidColorBrush x:Key="DangerSoft" Color="#1FE5484D" />
    <SolidColorBrush x:Key="DangerLine" Color="#73E5484D" />
    <SolidColorBrush x:Key="White" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeroText" Color="#D0D6DD" />
    <SolidColorBrush x:Key="SideText" Color="#B8C1CC" />

    <FontFamily x:Key="Plex">pack://application:,,,/Assets/Fonts/#IBM Plex Sans</FontFamily>
    <FontFamily x:Key="Mono">Consolas</FontFamily>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Text -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Plex}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="H2" TargetType="TextBlock" BasedOn="{StaticResource H1}">
        <Setter Property="FontSize" Value="22" />
    </Style>
    <Style x:Key="H3" TargetType="TextBlock" BasedOn="{StaticResource H1}">
        <Setter Property="FontSize" Value="17" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Plex}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="24" />
    </Style>
    <Style x:Key="Lead" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="LineHeight" Value="26" />
    </Style>
    <Style x:Key="Small" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="LineHeight" Value="20" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <!-- The site's small uppercase kicker above headings ("MSFS 2024"). -->
    <Style x:Key="Kicker" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Plex}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Icons}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The slanted R from rotaidem.com/logo.svg. -->
    <Geometry x:Key="LogoGeometry">F0 M2 9.2h11.5l-.6 2.6H1.4z M0.6 14.7h11.6l-.6 2.6H0z M2 20.2h9.2l-.6 2.6H1.4z M15 4h12.2a7.3 7.3 0 0 1 2.4 14.2L35 28h-6.4l-4.7-9h-3.6v9H15z m5.3 4.6v5.8h6.3a2.9 2.9 0 0 0 0-5.8z</Geometry>
    <Style x:Key="Logo" TargetType="Path">
        <Setter Property="Data" Value="{StaticResource LogoGeometry}" />
        <Setter Property="Fill" Value="{StaticResource Ink}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <SkewTransform AngleX="-14" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Buttons: square, like the site's .btn. Primary is ink on dark; hover goes white. -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" Stroke="{StaticResource AccentGlow}" StrokeThickness="3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Plex}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource Bg}" />
        <Setter Property="Background" Value="{StaticResource Ink}" />
        <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="22,12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Tag" Value="{StaticResource White}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="b" Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Any button without a style of its own looks like the site's primary button. -->
    <Style TargetType="Button" BasedOn="{StaticResource Btn}" />
    <Style x:Key="BtnAccent" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        <Setter Property="Foreground" Value="{StaticResource Navy}" />
        <Setter Property="Tag" Value="{StaticResource AccentHover}" />
    </Style>
    <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource GhostLine}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource NavyHover}" />
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Ink}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Ghost on top of a photo: white outline like the site's hero buttons. -->
    <Style x:Key="BtnHeroGhost" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
        <Setter Property="BorderBrush" Value="#73FFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource White}" />
    </Style>
    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
        <Setter Property="BorderBrush" Value="{StaticResource DangerLine}" />
        <Setter Property="Foreground" Value="{StaticResource Danger}" />
    </Style>
    <Style x:Key="BtnLight" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource White}" />
        <Setter Property="BorderBrush" Value="{StaticResource White}" />
        <Setter Property="Foreground" Value="{StaticResource Navy}" />
        <Setter Property="Tag" Value="{StaticResource Accent}" />
    </Style>
    <Style x:Key="Sm" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="SmPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="SmDanger" TargetType="Button" BasedOn="{StaticResource BtnDanger}">
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <!-- Underlined text link, accent underline like .more on the site. -->
    <Style x:Key="LinkBtn" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Plex}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <StackPanel Background="Transparent">
                        <ContentPresenter x:Name="c" />
                        <Rectangle x:Name="u" Height="1.5" Fill="{StaticResource Accent}" Margin="0,2,0,0" Opacity="0.8" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="u" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{StaticResource White}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MutedLink" TargetType="Button" BasedOn="{StaticResource LinkBtn}">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter Margin="0,0,0,2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Ink}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Square icon button (copy, refresh, window buttons). -->
    <Style x:Key="IconBtn" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource Icons}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource NavyHover}" />
                            <Setter Property="Foreground" Value="{StaticResource Ink}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="WindowBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="38" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Foreground" Value="{StaticResource SideText}" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>
    <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource WindowBtn}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#C42B1C" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar navigation: like the site's menu links, accent bar on the active one. -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource Plex}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource SideText}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="44" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="g" Background="Transparent">
                        <Rectangle x:Name="bar" Width="2" HorizontalAlignment="Left" Fill="{StaticResource Accent}" Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" Margin="22,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource Icon}" Width="20" Margin="0,0,14,0" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="g" Property="Background" Value="#0DFFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource White}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bar" Property="Visibility" Value="Visible" />
                            <Setter TargetName="g" Property="Background" Value="#0FFFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource White}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inputs: the site's fields (surface, field line, ink border and glow on focus). -->
    <Style x:Key="FieldBase" TargetType="Control">
        <Setter Property="FontFamily" Value="{StaticResource Plex}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource FieldLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,11" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>
    <ControlTemplate x:Key="FieldTemplate" TargetType="Control">
        <Grid>
            <Border x:Name="glow" Margin="-3" BorderBrush="{StaticResource AccentGlow}" BorderThickness="3" Visibility="Collapsed" />
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                <Grid>
                    <TextBlock x:Name="hint" Text="{TemplateBinding Tag}" Foreground="#5E646B" Margin="14,0" VerticalAlignment="Center"
                               FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" IsHitTestVisible="False" Visibility="Collapsed" />
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Ink}" />
                <Setter TargetName="glow" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="TextBox" BasedOn="{StaticResource FieldBase}">
        <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="glow" Margin="-3" BorderBrush="{StaticResource AccentGlow}" BorderThickness="3" Visibility="Collapsed" />
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                            <Grid>
                                <TextBlock x:Name="hint" Text="{TemplateBinding Tag}" Foreground="#5E646B" Margin="15,0" VerticalAlignment="Center"
                                           FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" IsHitTestVisible="False" Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Ink}" />
                            <Setter TargetName="glow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource FieldBase}">
        <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        <Setter Property="Template" Value="{StaticResource FieldTemplate}" />
    </Style>

    <!-- On/off switch for settings. -->
    <Style x:Key="Toggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,24,0" />
                        <Border x:Name="track" Grid.Column="1" Width="42" Height="22" Background="{StaticResource NavyHover}"
                                BorderBrush="{StaticResource FieldLine}" BorderThickness="1" VerticalAlignment="Center">
                            <Rectangle x:Name="knob" Width="14" Height="14" Fill="{StaticResource Muted}" HorizontalAlignment="Left" Margin="3,0" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="knob" Property="Fill" Value="{StaticResource Navy}" />
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thin progress line in the accent colour. -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="3" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="Background" Value="#33FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Maximum" Value="1" />
    </Style>

    <!-- Slim scrollbars. -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" Background="#33FFFFFF" Margin="3,2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Background" Value="#66FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="12" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" />
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Navy2}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="FontFamily" Value="{StaticResource Plex}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <!-- The site's .box panel. -->
    <Style x:Key="Box" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="28" />
    </Style>

    <!-- Pages fade and rise in a little when they open. -->
    <Style x:Key="Page" TargetType="UserControl">
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" From="10" To="0" Duration="0:0:0.3">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- A product in the sidebar's add-on list. -->
    <Style x:Key="SideProduct" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" Padding="20,8">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
