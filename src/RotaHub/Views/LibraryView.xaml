<UserControl x:Class="RotaHub.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource Page}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Shell}">
        <StackPanel Margin="48,40,40,48">
            <Grid Margin="0,0,0,32">
                <StackPanel>
                    <TextBlock Text="{Binding FirstName, StringFormat='WELCOME, {0}', Converter={StaticResource Upper}}" Style="{StaticResource Kicker}" Margin="0,0,0,10" />
                    <TextBlock Text="Library" Style="{StaticResource H1}" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Lead}" MaxWidth="620" HorizontalAlignment="Left"
                               Text="Every Rotaidem add-on. Install one and RotaHub puts it in place, links its in-game part into your simulator and keeps it up to date." />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource Sm}" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </Grid>

            <ProgressBar IsIndeterminate="True" Visibility="{Binding Loading, Converter={StaticResource Show}}" Margin="0,0,0,24" />

            <!-- Updates found on the website (a newer version set in the admin). -->
            <Border Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource Warn}" BorderThickness="3,0,0,0" Padding="20,14" Margin="0,0,28,28"
                    Visibility="{Binding Updates, Converter={StaticResource Show}}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Foreground="{StaticResource Warn}" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding UpdatesText}" Foreground="{StaticResource Ink}" FontSize="15" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource SmPrimary}" Command="{Binding UpdateAllCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Update all" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Background="{StaticResource DangerSoft}" Padding="18,14" Margin="0,0,0,24" Visibility="{Binding LoadError, Converter={StaticResource Show}}">
                <TextBlock Text="{Binding LoadError}" Style="{StaticResource Body}" Foreground="{StaticResource Ink}" />
            </Border>

            <Border Background="{StaticResource Bg2}" Padding="28,48" Visibility="{Binding NothingToShow, Converter={StaticResource Show}}">
                <StackPanel>
                    <TextBlock Text="Nothing here yet" Style="{StaticResource H3}" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource Muted}" Text="rotaidem.com lists no products right now. Check back soon." />
                </StackPanel>
            </Border>

            <!-- Featured: the first installed add-on (or the first on sale), large, like a launcher's front page. -->
            <Button DataContext="{Binding Featured}" Command="{Binding OpenCommand}" Margin="0,0,28,40" Cursor="Hand" FocusVisualStyle="{StaticResource FocusRing}"
                    Visibility="{Binding Converter={StaticResource Show}}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Height="300" ClipToBounds="True" Background="{StaticResource Navy}">
                            <Image Source="{Binding Picture}" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <ScaleTransform x:Name="zoom" />
                                </Image.RenderTransform>
                            </Image>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#E60B0C0E" Offset="0" />
                                        <GradientStop Color="#800B0C0E" Offset="0.55" />
                                        <GradientStop Color="#1A0B0C0E" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Border x:Name="edge" BorderBrush="{StaticResource Line}" BorderThickness="1" />
                            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="36,0,36,32" MaxWidth="560">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding Kicker, Converter={StaticResource Upper}}" Style="{StaticResource Kicker}" VerticalAlignment="Center" />
                                    <Border Margin="12,0,0,0" Padding="9,3" Background="{Binding BadgeTone, Converter={StaticResource ToneSoft}}">
                                        <TextBlock Text="{Binding Badge}" FontSize="12" FontWeight="Medium" Foreground="{Binding BadgeTone, Converter={StaticResource ToneInk}}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource H1}" FontSize="40" Foreground="{StaticResource White}" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding Tagline}" Style="{StaticResource Lead}" Foreground="{StaticResource HeroText}" Margin="0,0,0,22" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding PrimaryCommand}" Style="{StaticResource BtnLight}" Padding="24,12" MinWidth="170">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding PrimaryIcon}" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding PrimaryText}" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding StatusLine}" Foreground="{StaticResource HeroText}" FontSize="14" VerticalAlignment="Center" Margin="18,0,0,0" />
                                </StackPanel>
                                <ProgressBar Width="360" HorizontalAlignment="Left" Margin="0,16,0,0" Value="{Binding Progress, Mode=OneWay}"
                                             IsIndeterminate="{Binding Indeterminate, Mode=OneWay}" Visibility="{Binding Busy, Converter={StaticResource Show}}" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="edge" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="zoom" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.8" />
                                            <DoubleAnimation Storyboard.TargetName="zoom" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.8" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="zoom" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.5" />
                                            <DoubleAnimation Storyboard.TargetName="zoom" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.5" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <TextBlock Text="All add-ons" Style="{StaticResource H2}" Margin="0,0,0,18" Visibility="{Binding Products.Count, Converter={StaticResource Show}}" />

            <ItemsControl ItemsSource="{Binding Products}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- The site's product card: 16:10 picture, then name and price; badge on the picture. -->
                        <Button Command="{Binding OpenCommand}" Width="336" Margin="0,0,28,32" Cursor="Hand" FocusVisualStyle="{StaticResource FocusRing}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="card" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="lift" />
                                        </Border.RenderTransform>
                                        <StackPanel>
                                            <Grid Height="210" ClipToBounds="True" Background="{StaticResource Bg2}">
                                                <Image x:Name="pic" Source="{Binding Picture}" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
                                                    <Image.RenderTransform>
                                                        <ScaleTransform x:Name="zoom" ScaleX="1" ScaleY="1" />
                                                    </Image.RenderTransform>
                                                </Image>
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" Padding="9,3"
                                                        Background="#E60B0C0E">
                                                    <TextBlock Text="{Binding Badge}" FontSize="12" FontWeight="Medium"
                                                               Foreground="{Binding BadgeTone, Converter={StaticResource ToneInk}}" />
                                                </Border>
                                                <ProgressBar VerticalAlignment="Bottom" Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding Indeterminate}"
                                                             Visibility="{Binding Busy, Converter={StaticResource Show}}" />
                                            </Grid>
                                            <StackPanel Margin="22,20,22,22">
                                                <TextBlock Text="{Binding Kicker, Converter={StaticResource Upper}}" Style="{StaticResource Kicker}" Margin="0,0,0,8" />
                                                <Grid>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H3}" FontSize="19" TextTrimming="CharacterEllipsis" Margin="0,0,70,0" />
                                                    <TextBlock Text="{Binding CardVersion}" HorizontalAlignment="Right" Foreground="{StaticResource Ink}" FontWeight="SemiBold" FontSize="15" />
                                                </Grid>
                                                <TextBlock Text="{Binding Tagline}" Style="{StaticResource Small}" FontSize="14" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                <Grid Margin="0,18,0,0">
                                                    <TextBlock Text="{Binding Step}" Style="{StaticResource Small}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap" Margin="0,0,110,0" />
                                                    <Button HorizontalAlignment="Right" Command="{Binding PrimaryCommand}" Style="{StaticResource SmPrimary}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding PrimaryIcon}" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                                                            <TextBlock Text="{Binding PrimaryText}" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="zoom" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.6" />
                                                        <DoubleAnimation Storyboard.TargetName="lift" Storyboard.TargetProperty="Y" To="-4" Duration="0:0:0.2" />
                                                        <DoubleAnimation Storyboard.TargetName="zoom" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.6" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="zoom" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.4" />
                                                        <DoubleAnimation Storyboard.TargetName="lift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2" />
                                                        <DoubleAnimation Storyboard.TargetName="zoom" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.4" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
