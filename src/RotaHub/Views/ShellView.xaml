<UserControl x:Class="RotaHub.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RotaHub.ViewModels"
             xmlns:v="clr-namespace:RotaHub.Views">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:LibraryPage}">
            <v:LibraryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductViewModel}">
            <v:ProductView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:KeysViewModel}">
            <v:KeysView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <v:SettingsView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: the site's dark header colours. -->
        <Border Background="{StaticResource Navy}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="MENU" Style="{StaticResource Kicker}" Foreground="{StaticResource Muted}" Margin="24,26,0,10" />
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE71D;" Content="Library" IsChecked="{Binding IsLibrary}" GroupName="nav" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE192;" Content="Licence keys" IsChecked="{Binding IsKeys}" GroupName="nav" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Settings" IsChecked="{Binding IsSettings}" GroupName="nav" />
                </StackPanel>

                <!-- Account, bottom of the sidebar. -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,18">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" Background="{StaticResource Accent}">
                                <TextBlock Text="{Binding Initial}" Foreground="{StaticResource Navy}" FontWeight="SemiBold" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Account.Name}" Foreground="{StaticResource White}" FontWeight="Medium" FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Account.Email}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Account" Style="{StaticResource Sm}" Command="{Binding AccountCommand}" Margin="0,0,8,0" ToolTip="Your account on rotaidem.com" />
                            <Button Content="Log out" Style="{StaticResource Sm}" Command="{Binding SignOutCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Margin="20,0,20,16" Padding="14,12" Background="{StaticResource Navy2}"
                        Visibility="{Binding Offline, Converter={StaticResource Show}}">
                    <StackPanel>
                        <TextBlock Text="Offline" Foreground="{StaticResource Warn}" FontWeight="Medium" FontSize="13" />
                        <TextBlock Style="{StaticResource Small}" FontSize="12" Text="rotaidem.com can't be reached. Installed products still launch." />
                    </StackPanel>
                </Border>

                <Button DockPanel.Dock="Bottom" Style="{StaticResource MutedLink}" Command="{Binding WebsiteCommand}" Margin="24,0,0,18"
                        HorizontalAlignment="Left" FontSize="13">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="rotaidem.com" />
                        <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="11" Margin="6,1,0,0" />
                    </StackPanel>
                </Button>
                <Grid />
            </DockPanel>
        </Border>

        <!-- Page area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- RotaHub update, like the site's announcement bar. -->
            <Border Background="{StaticResource Ink}" Visibility="{Binding SelfUpdate, Converter={StaticResource Show}}">
                <Grid Margin="24,0" MinHeight="44">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Foreground="{StaticResource Bg}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding SelfUpdateText}" Foreground="{StaticResource Bg}" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SelfUpdateStep}" Foreground="#5A6067" FontSize="13" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="Update and restart" Command="{Binding SelfUpdateCommand}"
                            Style="{StaticResource SmPrimary}" Background="{StaticResource Navy}" BorderBrush="{StaticResource Navy}"
                            Foreground="{StaticResource White}" Tag="{StaticResource NavyHover}" />
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding Page}" Focusable="False" />

            <!-- Toast -->
            <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24" MaxWidth="460"
                    Background="{StaticResource Navy2}" BorderThickness="3,0,0,0" Padding="18,14"
                    Visibility="{Binding ToastText, Converter={StaticResource Show}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ToastError}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.45" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ToastText}" Style="{StaticResource Body}" Foreground="{StaticResource Ink}" FontSize="14" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource IconBtn}" Content="&#xE711;" FontSize="10" Width="26" Height="26" Margin="12,0,0,0"
                            Command="{Binding DismissToastCommand}" VerticalAlignment="Top" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
