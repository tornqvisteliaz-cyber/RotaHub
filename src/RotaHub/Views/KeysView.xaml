<UserControl x:Class="RotaHub.Views.KeysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{StaticResource Page}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="48,40,48,48" MaxWidth="1100" HorizontalAlignment="Left">
            <Grid Margin="0,0,0,32">
                <StackPanel>
                    <TextBlock Text="YOUR ACCOUNT" Style="{StaticResource Kicker}" Margin="0,0,0,10" />
                    <TextBlock Text="Licence keys" Style="{StaticResource H1}" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Lead}" MaxWidth="640" HorizontalAlignment="Left"
                               Text="The keys on your Rotaidem account. Activate one on this PC and the product starts ready to use, no key to type." />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource Sm}" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Table, like the site's .table -->
            <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Visibility="{Binding HasKeys, Converter={StaticResource Show}}">
                <StackPanel>
                    <Grid Background="{StaticResource Bg2}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2.4*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="FontWeight" Value="Medium" />
                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                <Setter Property="Margin" Value="18,12" />
                            </Style>
                        </Grid.Resources>
                        <TextBlock Text="Product" />
                        <TextBlock Grid.Column="1" Text="Key" />
                        <TextBlock Grid.Column="2" Text="Status" />
                        <TextBlock Grid.Column="3" Text="This PC" />
                        <TextBlock Grid.Column="4" Text="" Width="150" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                                    <Grid MinHeight="68">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="2.4*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1.6*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="18,12" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProductName}" Foreground="{StaticResource Ink}" FontWeight="Medium" FontSize="15" />
                                            <TextBlock Text="{Binding Added}" Style="{StaticResource Small}" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,12" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Key}" FontFamily="{StaticResource Mono}" FontSize="15" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                            <Button Style="{StaticResource IconBtn}" Content="&#xE8C8;" Command="{Binding CopyCommand}" Margin="8,0,0,0" ToolTip="Copy the key" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="18,12" VerticalAlignment="Center">
                                            <Border Padding="9,3" HorizontalAlignment="Left" Background="{Binding StatusTone, Converter={StaticResource ToneSoft}}">
                                                <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="Medium" Foreground="{Binding StatusTone, Converter={StaticResource ToneInk}}" />
                                            </Border>
                                            <TextBlock Text="{Binding Activations}" Style="{StaticResource Small}" FontSize="12" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="18,12" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="{Binding HereTone, Converter={StaticResource ToneInk}}" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding HereText}" Foreground="{StaticResource Text}" FontSize="14" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="4" Width="150" Margin="0,0,18,0" Content="{Binding ToggleText}" Command="{Binding ToggleCommand}"
                                                VerticalAlignment="Center" Style="{StaticResource Sm}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource Bg2}" Padding="28,40" Visibility="{Binding HasKeys, Converter={StaticResource Hide}}">
                <StackPanel>
                    <TextBlock Text="No keys on this account yet" Style="{StaticResource H3}" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource Muted}" Margin="0,0,0,18"
                               Text="Keys you buy with this account's email address appear here by themselves. Have a key from somewhere else? Add it below." />
                    <Button Content="See the add-ons" Style="{StaticResource Sm}" Command="{Binding BuyCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- Add a key -->
            <Border Style="{StaticResource Box}" Margin="0,32,0,0" MaxWidth="640" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="Add a key" Style="{StaticResource H3}" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource Muted}" Margin="0,0,0,18"
                               Text="A key from a purchase email or a gift. RotaHub adds it to your account and activates it on this PC." />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewKey, UpdateSourceTrigger=PropertyChanged}" Tag="HPRO-XXXX-XXXX-XXXX" FontFamily="{StaticResource Mono}"
                                 CharacterCasing="Upper" FontSize="16">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AddCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="Add and activate" Command="{Binding AddCommand}" Margin="10,0,0,0" />
                    </Grid>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Body}" FontSize="14" Margin="0,12,0,0"
                               Foreground="{Binding Tone, Converter={StaticResource ToneInk}}" Visibility="{Binding Message, Converter={StaticResource Show}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
