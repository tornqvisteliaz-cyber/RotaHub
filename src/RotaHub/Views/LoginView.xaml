<UserControl x:Class="RotaHub.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">
    <!-- rotaidem.com/login: photo with the welcome on the left, the form on the right. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid ClipToBounds="True">
            <Image Source="{Binding SidePicture}" Stretch="UniformToFill" HorizontalAlignment="Right" />
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Color="#F20B0C0E" Offset="0" />
                        <GradientStop Color="#990B0C0E" Offset="0.35" />
                        <GradientStop Color="#000B0C0E" Offset="0.75" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <StackPanel VerticalAlignment="Bottom" Margin="56" MaxWidth="440" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Path Style="{StaticResource Logo}" Width="34" Height="25" />
                    <TextBlock Text="ROTAHUB" Foreground="{StaticResource White}" FontWeight="SemiBold" FontSize="15" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Welcome back" Style="{StaticResource H1}" Foreground="{StaticResource White}" Margin="0,0,0,12" />
                <TextBlock Style="{StaticResource Lead}" Foreground="{StaticResource SideText}"
                           Text="Your Rotaidem add-ons, licence keys and updates in one place. Install with one click and RotaHub keeps them up to date." />
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1">
            <StackPanel Width="400" VerticalAlignment="Center" Margin="24,40">
                <TextBlock Text="Log in" Style="{StaticResource H1}" FontSize="32" Margin="0,0,0,8" />
                <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource Muted}" Margin="0,0,0,26"
                           Text="Use your rotaidem.com account: the email address or username you signed up with." />

                <TextBlock Text="Email or username" Style="{StaticResource Label}" />
                <TextBox x:Name="Email" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,18" />

                <TextBlock Text="Password" Style="{StaticResource Label}" />
                <PasswordBox x:Name="Password" />

                <Button Content="Forgot password?" Style="{StaticResource MutedLink}" Command="{Binding ForgotCommand}"
                        HorizontalAlignment="Right" Margin="0,10,0,20" />

                <Button Command="{Binding LoginCommand}" CommandParameter="{Binding ElementName=Password}" Style="{StaticResource Btn}"
                        HorizontalAlignment="Stretch" IsDefault="True">
                    <Grid>
                        <TextBlock Text="Log in" />
                    </Grid>
                </Button>

                <TextBlock Text="{Binding Error}" Style="{StaticResource Body}" FontSize="14" Margin="0,12,0,0"
                           Foreground="{Binding Tone, Converter={StaticResource ToneInk}}"
                           Visibility="{Binding Error, Converter={StaticResource Show}}" />
                <Button Content="Send the confirmation link again" Style="{StaticResource LinkBtn}" Command="{Binding ResendCommand}"
                        HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding Unverified, Converter={StaticResource Show}}" />

                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,22,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="New to Rotaidem? " Style="{StaticResource Body}" FontSize="14" Foreground="{StaticResource Muted}" />
                        <Button Content="Create an account" Style="{StaticResource LinkBtn}" Command="{Binding SignUpCommand}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24">
                <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,8,0" />
                <TextBlock Style="{StaticResource Small}" Text="Your login goes only to rotaidem.com. It shows on the website under your account's logins." />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
